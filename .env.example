# ---------------------------------------------------------------------------
# Traction Rec (Salesforce) — OAuth 2.0 client_credentials
# Sandbox values live in KROC-draft/"tractionrec creds.md". NEVER commit them.
# In Cloud Functions these come from Secret Manager, not from a .env file.
# ---------------------------------------------------------------------------
TR_LOGIN_URL=https://krocphoenix--phoenixfsb.sandbox.my.salesforce.com
TR_API_VERSION=v62.0
TR_CLIENT_ID=
TR_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Zesty
# Prefer an instance API token over email/password: it is scoped to one
# instance and can be revoked without touching a human account.
# ---------------------------------------------------------------------------
ZESTY_INSTANCE_ZUID=8-80c0bba6b8-lhkcc7
ZESTY_INSTANCE_TOKEN=
# Fallback only — the SDK exchanges these for a token via auth.api.zesty.io
ZESTY_USER_EMAIL=
ZESTY_USER_PASSWORD=

# ---------------------------------------------------------------------------
# Run behaviour
# ---------------------------------------------------------------------------
# Comma-separated tiers, in dependency order. Default: all four.
SYNC_TIERS=program_category,program,course,class
# 1 = plan and log, write nothing. Leave this on until a plan reads correctly.
DRY_RUN=1
# 1 = create missing Zesty items. 0 = report them as missing and move on.
CREATE_MISSING_ITEMS=1
# Deletion is never automatic. Orphans are only ever reported.
# Shared secret required in the X-Sync-Key header when invoked over HTTP.
SYNC_TRIGGER_KEY=

# ---------------------------------------------------------------------------
# Seed template (TEMPORARY)
# Zesty enforces required fields on create, and the service cannot supply a
# hero image or a subtitle. Point a tier at an existing item and its values are
# copied into REQUIRED fields only, and only where nothing else filled them.
# Remove this once `required` is cleared on the editorial fields.
#   SEED_TEMPLATE_ITEMS=program_category:7-…,class:7-…
# ---------------------------------------------------------------------------
SEED_TEMPLATE_ITEMS=
