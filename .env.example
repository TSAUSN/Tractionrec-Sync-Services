# Local settings: copy to .env (gitignored) and fill in.
#
# The deployed function doesn't read this file. A center's settings are in
# centers.yaml and its passwords in Secret Manager (deploy/README.md); a local
# --center=<id> run reads them the same way, through your gcloud sign-in.
# This file is for local runs WITHOUT --center (and the scenario / live-cache
# tests), and for how runs behave on this machine.
#
# Every setting and where it's read:
#
#   setting                   .env   a center (centers.yaml / Secret Manager)   deployed function
#   TR_LOGIN_URL                yes    tractionRec.loginUrl                         centers.yaml
#   TR_API_VERSION              yes    tractionRec.apiVersion                       centers.yaml
#   TR_CLIENT_ID                yes    secret center-<id>-tr-client-id              Secret Manager
#   TR_CLIENT_SECRET            yes    secret center-<id>-tr-client-secret          Secret Manager
#   ZESTY_INSTANCE_ZUID         yes    zesty.instanceZuid                           centers.yaml
#   ZESTY_INSTANCE_TOKEN        yes    secret center-<id>-zesty-token               Secret Manager
#   ZESTY_USER_EMAIL/PASSWORD   yes    -                                            -  (fallback login)
#   (name, schedule)            -      name, schedule.cron, schedule.timeZone       centers.yaml -> its job
#   DRY_RUN                     yes    applies to --center runs too                 env var, 0 (deploy.sh)
#   SYNC_TRIGGER_KEY            yes*   -                                            secret sync-trigger-key
#   LOG_LEVEL and the test URLs yes    applies to --center runs too                 -
#   GCP_PROJECT                 opt.   the project --center reads secrets from      env var (deploy.sh)
#
#   * read only by deploy/secrets.sh, when it creates the deployed key.

# ---------------------------------------------------------------------------
# Traction Rec (Salesforce) — OAuth 2.0 client_credentials
# Sandbox values live in KROC-draft/"tractionrec creds.md". NEVER commit them.
# ---------------------------------------------------------------------------
TR_LOGIN_URL=https://krocphoenix--phoenixfsb.sandbox.my.salesforce.com
TR_API_VERSION=v62.0
TR_CLIENT_ID=
TR_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Zesty
# Prefer an instance API token over email/password: it is scoped to one
# instance and can be revoked without touching a human account.
# ---------------------------------------------------------------------------
ZESTY_INSTANCE_ZUID=8-80c0bba6b8-lhkcc7
ZESTY_INSTANCE_TOKEN=
# Fallback only — the SDK exchanges these for a token via auth.api.zesty.io.
# Not read for a center run: a center always uses its instance token.
ZESTY_USER_EMAIL=
ZESTY_USER_PASSWORD=

# ---------------------------------------------------------------------------
# Run behaviour (applies to center runs too)
# ---------------------------------------------------------------------------
# 1 = plan and log, write nothing. Leave this on until a plan reads correctly.
# `npm run sync -- --live` overrides it for one local run.
DRY_RUN=1
# The X-Sync-Key every HTTP caller must send. Read here only by
# deploy/secrets.sh: the value it stores as the sync-trigger-key secret when
# creating it (or with --rotate-key); empty = it generates one. Local runs
# don't use it (`npm start` doesn't load .env; export it to test the check).
SYNC_TRIGGER_KEY=
# Nothing is ever deleted: a record that leaves Traction Rec's published set
# becomes active = 0 on its dataset item.

# Optional. Uncomment to change a default.
# LOG_LEVEL=debug                                          # also log debug lines
# ZESTY_STAGE_URL=https://6wz46m14-dev.webengine.zesty.io  # scenario tests
# ZESTY_LIVE_URL=https://kroc.zesty.dev                    # live-cache test
# LIVE_CACHE_TIMEOUT_MS=600000                             # live-cache test
# RUNNER_PORT=8787                                         # npm run runner
# GCP_PROJECT=kroc-services                                # --center: secrets project (default: gcloud's)
