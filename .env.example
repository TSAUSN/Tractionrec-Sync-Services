# ---------------------------------------------------------------------------
# Traction Rec (Salesforce) — OAuth 2.0 client_credentials
# Sandbox values live in KROC-draft/"tractionrec creds.md". NEVER commit them.
# In Cloud Functions these come from Secret Manager, not from a .env file.
# ---------------------------------------------------------------------------
TR_LOGIN_URL=https://krocphoenix--phoenixfsb.sandbox.my.salesforce.com
TR_API_VERSION=v62.0
TR_CLIENT_ID=
TR_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Zesty
# Prefer an instance API token over email/password: it is scoped to one
# instance and can be revoked without touching a human account.
# ---------------------------------------------------------------------------
ZESTY_INSTANCE_ZUID=8-80c0bba6b8-lhkcc7
ZESTY_INSTANCE_TOKEN=
# Fallback only — the SDK exchanges these for a token via auth.api.zesty.io
ZESTY_USER_EMAIL=
ZESTY_USER_PASSWORD=

# ---------------------------------------------------------------------------
# Run behaviour
# ---------------------------------------------------------------------------
# 1 = plan and log, write nothing. Leave this on until a plan reads correctly.
# `npm run sync -- --live` overrides it for one local run.
DRY_RUN=1
# Shared secret required in the X-Sync-Key header when invoked over HTTP
# (the service that calls this function sends it).
SYNC_TRIGGER_KEY=
# Nothing is ever deleted: a record that leaves Traction Rec's published set
# becomes active = 0 on its dataset item.

# Optional, for the scenario / live-cache tests only:
# ZESTY_STAGE_URL=https://6wz46m14-dev.webengine.zesty.io
# ZESTY_LIVE_URL=https://kroc.zesty.dev
