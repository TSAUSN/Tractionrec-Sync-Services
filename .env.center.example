# One Kroc center: copy to .env.<id> (gitignored), e.g. .env.phoenix, and fill
# in. <id> is lowercase letters, digits and hyphens. A .env.<id> counts as a
# center only when it sets CENTER_NAME.
#
# Locally:  npm run sync:dry -- --center=<id> --summary
# Deployed: bash deploy/secrets.sh <id> copies this file into Secret Manager
#           as center-<id>, which the function reads on every run; then
#           bash deploy/deploy.sh schedule check   (deploy/README.md)
CENTER_NAME=

# Traction Rec (Salesforce): the org and its client-credentials app
TR_LOGIN_URL=https://<org>.my.salesforce.com
TR_API_VERSION=v62.0
TR_CLIENT_ID=
TR_CLIENT_SECRET=

# Zesty: the center's instance and its instance access token
ZESTY_INSTANCE_ZUID=8-
ZESTY_INSTANCE_TOKEN=

# Daily run: cron and IANA time zone (the Cloud Scheduler job)
SCHEDULE=0 0 * * *
TIME_ZONE=America/Phoenix
