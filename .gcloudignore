# What `gcloud functions deploy --source=.` leaves out. The function needs
# src/, zesty-models/ (read at runtime: the schema check), centers.yaml (the
# center list), package.json and package-lock.json. Everything else stays
# local; .env is never uploaded: the function reads passwords from Secret Manager.
.gcloudignore
.git
.gitignore
node_modules/
.env
.env.*
*.log
archive/
docs/
test/
README.md
AGENTS.md

deploy/
.github/

# Written by google-github-actions/auth into the workspace; never commit or upload
gha-creds-*.json
